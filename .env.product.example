# AI Receptionist Pro — buyer environment template
# Copy to .env.local or configure these values in your hosting provider.
# Never commit real credentials.

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Receptionist Pro"
NEXT_PUBLIC_APP_VERSION="1.0.0"
LOG_LEVEL="info"
NODE_ENV="development"
APP_ENV="development"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOURPROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_URL=""
SUPABASE_MEDIA_BUCKET="ai-receptionist-media"

# Background jobs
INTERNAL_JOB_SECRET=""
INTERNAL_JOB_HEADER_NAME="x-ambrogio-job-secret"
CRON_SECRET=""

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_PRIMARY=""
ANTHROPIC_MODEL_FAST=""
AMBROGIO_AI_AUTOREPLY_ENABLED="false"
AMBROGIO_VOICE_STT_MIN_CONFIDENCE="0.55"

# OpenAI embeddings (optional)
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# ElevenLabs voice (optional)
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL="scribe_v2"
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"
ELEVENLABS_DEFAULT_VOICE_ID=""
ELEVENLABS_ENABLE_LOGGING="false"

# WhatsApp via 360dialog
WHATSAPP_API_KEY=""
WHATSAPP_API_URL="https://waba-v2.360dialog.io"
WHATSAPP_MEDIA_MAX_BYTES="26214400"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_WEBHOOK_HEADER_NAME="x-ambrogio-webhook-secret"
WHATSAPP_WEBHOOK_HEADER_SECRET=""
WHATSAPP_WEBHOOK_RATE_LIMIT_MAX="120"
WHATSAPP_WEBHOOK_RATE_LIMIT_WINDOW_MS="60000"

# Email via Resend (optional)
OPS_ALERT_EMAIL=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AI Receptionist Pro <hello@yourdomain.com>"
RESEND_API_URL="https://api.resend.com/emails"

# Google Calendar
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_STATE_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=""

# Stripe billing
STRIPE_SECRET_KEY=""
WHSEC_STRIPE_WEBHOOK=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_BILLING_PORTAL_RETURN_URL="http://localhost:3000/dashboard/billing"
STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3000/dashboard/billing?checkout=success"
STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3000/dashboard/billing?checkout=cancel"

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
